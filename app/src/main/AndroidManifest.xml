<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ArcxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArcX">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ArcX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Long-press menu on the app icon. Declared on this Activity rather than the alias
              below because the launcher reads the static set from the app's main entry, and this
              is the icon a user long-presses.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          One entry point for every launch surface. Standard launch mode (not singleTask) is
          required: ACTION_PROCESS_TEXT returns its replacement via setResult, which only
          reaches the caller when this runs in the caller's task.
        -->
        <activity
            android:name=".runner.RunnerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.ArcX.Translucent">

            <!-- Text selection menu. Arc does not offer this at all. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- arcx://run/{workflowId} — shortcuts, widget, tile and the floating bubble. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="arcx" android:host="run" />
            </intent-filter>

        </activity>

        <!--
          A launcher-visible door to the picker. RunnerActivity already *is* the picker when no
          workflow id comes with the intent — the Quick Settings tile and arcx://run/ both rely on
          that — but only a component carrying MAIN/LAUNCHER can be seen by the surfaces that let a
          user wire up their own trigger: a home-screen icon, Samsung's Apps edge panel, Bixby
          Routines, a side-key gesture, a third-party launcher's gesture binding.

          An alias rather than a second Activity, because there is no second behaviour to write —
          it is the same component under a name the system can enumerate.
        -->
        <activity-alias
            android:name=".runner.ActionsAlias"
            android:exported="true"
            android:label="@string/arcx_actions_label"
            android:targetActivity=".runner.RunnerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
