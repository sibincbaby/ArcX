<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything here merges into the app's resource table, so every name is arcx_-prefixed to keep
  this module from silently overwriting a string the app or another feature owns.
-->
<resources>

    <string name="arcx_accessibility_label">ArcX screen reading</string>

    <!--
      The description itself lives in :core:designsystem so this screen and Settings > Entry
      points cannot disagree about what the permission does. See the comment there.
    -->

    <!--
      The names still read arcx_bubble_* because the setting that switches this on is still
      bubbleEnabled, and one of the two had to stay put. The wording follows the surface.
    -->
    <string name="arcx_bubble_channel_name">Edge sidebar</string>
    <string name="arcx_bubble_channel_description">Silent notification shown while the ArcX sidebar is on screen. Android requires it.</string>
    <string name="arcx_bubble_notification_title">ArcX sidebar is on</string>
    <string name="arcx_bubble_notification_text">Tap or swipe the edge strip to run a workflow from any app.</string>
    <string name="arcx_bubble_stop">Stop</string>
    <string name="arcx_bubble_title">Run on this app</string>
    <!-- What the panel will feed the workflow if the launch carries no text of its own. -->
    <string name="arcx_bubble_source">clipboard or screen</string>
    <string name="arcx_bubble_more">All workflows</string>
    <string name="arcx_bubble_empty">Star a workflow in ArcX to reach it from here.</string>

    <string name="arcx_widget_label">ArcX favorites</string>
    <string name="arcx_widget_description">Run a favorite ArcX workflow straight from the home screen.</string>
    <string name="arcx_widget_empty">Add favorites in ArcX</string>

    <string name="arcx_tile_label">ArcX</string>

</resources>
